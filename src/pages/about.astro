---
import Base from '../layouts/Base.astro';
---

<Base title="About | Anh Pham">
  <div class="page">
    <h1>About</h1>

    <div class="about-grid">
      <div class="story">
        <p class="lede">[Placeholder] The story, told properly, arrives in Phase 3.</p>
        <p>
          [Placeholder] A few paragraphs in Anh's own voice: where she's from, how she got here,
          what she cares about in work and outside it. Drafted together in the content interview,
          then edited until it sounds like her and nobody else.
        </p>
      </div>
      <!-- Swappable slot: real photo lands here in Phase 3. -->
      <figure class="photo" aria-label="Photo placeholder">
        <div class="photo-frame">
          <span class="label">photo slot</span>
        </div>
      </figure>
    </div>
  </div>
</Base>

<style>
  .about-grid {
    display: flex;
    gap: 3rem;
    align-items: flex-start;
  }

  .story {
    max-width: var(--measure);
  }

  .lede {
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .photo {
    margin: 0;
    flex: 0 0 240px;
  }

  .photo-frame {
    aspect-ratio: 4 / 5;
    border: 1px solid var(--hairline);
    display: grid;
    place-items: center;
  }

  @media (max-width: 720px) {
    .about-grid {
      flex-direction: column;
    }

    .photo {
      flex-basis: auto;
      width: 200px;
    }
  }
</style>
