---
import Base from '../layouts/Base.astro';
---

<Base title="Anh Pham">
  <div class="page">
    <section class="hero">
      <div class="hero-text">
        <h1>Hi, I'm Anh.</h1>
        <p class="lede">
          I build software products for a living. I also translate books from English to
          Vietnamese, read a lot, and run to clear my head. This site is where all of that lives.
        </p>
      </div>
      <!-- Swappable slot: line-art portrait lands here in Phase 3. -->
      <div class="portrait" aria-hidden="true">
        <svg viewBox="0 0 200 240" fill="none" stroke="#111111" stroke-width="2.5" stroke-linecap="round">
          <circle cx="100" cy="88" r="52" />
          <path d="M56 224 C 60 158, 140 158, 144 224" />
          <path d="M74 78 q 8 -10 18 -2" />
          <path d="M112 76 q 8 -8 16 0" />
          <path d="M92 112 q 8 8 18 1" />
        </svg>
        <span class="label">portrait slot</span>
      </div>
    </section>

    <section class="section">
      <span class="label">Work</span>
      <h2>Product problems, worked through</h2>
      <p>
        Case studies from nearly a decade across energy, retail, and software: the context, the
        calls I made, and what the numbers did.
      </p>
      <a class="cta" href="/work/">See the work &rarr;</a>
    </section>

    <section class="section">
      <span class="label">Writing</span>
      <h2>Notes and essays</h2>
      <p>Occasional writing. Some of it in English, some in Vietnamese.</p>
      <a class="cta" href="/writing/">Read the latest &rarr;</a>
    </section>

    <section class="section">
      <span class="label">Hobbies</span>
      <h2>Off hours</h2>
      <p>
        Nine translated books, a long-running TED translation habit, book reviews, and slow
        kilometres around the North Shore.
      </p>
      <a class="cta" href="/hobbies/">See what I'm into &rarr;</a>
    </section>
  </div>
</Base>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
  }

  .hero-text {
    max-width: var(--measure);
  }

  .lede {
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .portrait {
    flex: 0 0 auto;
    width: 180px;
    text-align: center;
  }

  .portrait svg {
    width: 100%;
  }

  @media (max-width: 720px) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
    }

    .portrait {
      width: 120px;
    }
  }
</style>
