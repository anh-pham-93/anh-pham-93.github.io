---
import Base from '../../layouts/Base.astro';

// Placeholder entries. Real posts become Markdown files in src/content/ from Phase 3.
const posts = [
  {
    title: '[Placeholder] First post',
    date: '2026',
    summary: 'The first real post replaces this row.',
    lang: 'EN',
  },
  {
    title: '[Placeholder] Bài viết tiếng Việt',
    date: '2026',
    summary: 'Một bài viết bằng tiếng Việt trông như thế này.',
    lang: 'VN',
  },
];
---

<Base title="Writing | Anh Pham">
  <div class="page">
    <h1>Writing</h1>
    <p class="lede">
      Notes and essays, written when there is something worth writing down. Some in English, some
      in Vietnamese.
    </p>

    <section class="section">
      <ul class="rows">
        {posts.map((post) => (
          <li>
            <span class="label">{post.date} · {post.lang}</span>
            <h3><a href="#">{post.title}</a></h3>
            <p class="muted">{post.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .lede {
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  h3 {
    margin-block: 0.35em 0.25em;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    background: none;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }
</style>
